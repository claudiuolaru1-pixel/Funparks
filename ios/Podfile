platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  core_plugin = Dir.glob("#{ENV['HOME']}/.pub-cache/**/FLTFirebaseCorePlugin.m").first
  if core_plugin
    content = File.read(core_plugin)

    # Log appNamed context to help diagnose
    appnamed_lines = content.scan(/.{0,60}appNamed.{0,60}/)
    puts "[Funparks] appNamed lines: #{appnamed_lines.inspect}"

    unless content.include?('@try { [FIRApp configureWithName:')
      content.gsub!(/(\[FIRApp configureWithName:[^\]]+\];)/) { |m| "@try { #{m} } @catch (NSException *__e) { NSLog(@\"FunparksPatch\"); }" }
      puts "[Funparks] Core @try-@catch applied"
    end

    # Broad pattern - match ANY [FIRApp appNamed:...] call
    unless content.include?('FunparksPatch2')
      before = content.dup
      content.gsub!(/\[FIRApp appNamed:[^\]]+\]/) { |match| "(#{match} ?: [FIRApp defaultApp]) /* FunparksPatch2 */" }
      if content != before
        puts "[Funparks] appNamed fallback applied"
      else
        puts "[Funparks] WARNING: appNamed pattern not found!"
      end
    end

    File.write(core_plugin, content)
    puts "[Funparks] Core saved"
  end

  auth_plugin = Dir.glob("#{ENV['HOME']}/.pub-cache/**/FLTFirebaseAuthPlugin.m").first
  if auth_plugin
    content = File.read(auth_plugin)
    unless content.include?('FunparksAuthPatch')
      content.sub!(/pluginConstantsForFIRApp:[^{]+\{/) do |match|
        match + "\n  return @{@\"APP_VERIFICATION_DISABLED_FOR_TESTING\": @(NO), @\"APP_LANGUAGE_CODE\": [NSNull null]}; // FunparksAuthPatch"
      end
      File.write(auth_plugin, content)
      puts "[Funparks] Auth patched"
    end
  end
end