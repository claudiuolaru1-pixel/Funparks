platform :ios, '14.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Patch FLTFirebaseCorePlugin.m with @try-@catch before Xcode compiles it
  plugin_file = Dir.glob("#{ENV['HOME']}/.pub-cache/**/FLTFirebaseCorePlugin.m").first
  if plugin_file
    puts "[Funparks] Patching #{plugin_file}"
    content = File.read(plugin_file)
    if content.include?('@try { [FIRApp configureWithName:')
      puts "[Funparks] Already correctly patched"
    else
      # Fix broken patch (missing @ before try/catch)
      content.gsub!(/(?<![@ \t])try \{ \[FIRApp configureWithName:/, '@try { [FIRApp configureWithName:')
      content.gsub!(/\} catch \(NSException \*__e\)/, '} @catch (NSException *__e)')
      # Apply fresh patch if still not patched
      unless content.include?('@try { [FIRApp configureWithName:')
        content.gsub!(/(\[FIRApp configureWithName:[^\]]+\];)/) do |m|
          "@try { #{m} } @catch (NSException *__e) { NSLog(@\"FunparksPatch\"); }"
        end
      end
      File.write(plugin_file, content)
      puts "[Funparks] Patched!"
    end
  else
    puts "[Funparks] WARNING: FLTFirebaseCorePlugin.m not found!"
  end
end