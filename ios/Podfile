platform :ios, '14.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Add pre-compile patch script to firebase_core pod target
  # $PODS_TARGET_SRCROOT points directly to the plugin source dir
  firebase_target = installer.pods_project.targets.find { |t| t.name == 'firebase_core' }
  if firebase_target
    patch_script = <<~'PATCHSCRIPT'
      #!/bin/sh
      PLUGIN=$(find "$PODS_TARGET_SRCROOT" -name "FLTFirebaseCorePlugin.m" 2>/dev/null | head -1)
      echo "[Funparks] FLTFirebaseCorePlugin.m: $PLUGIN"
      if [ -n "$PLUGIN" ] && ! grep -q "FunparksPatch" "$PLUGIN"; then
        perl -i -0pe 's/(\[FIRApp configureWithName:[^\]]+\];)/@try { $1 } @catch (NSException *__e) { NSLog(@"[Funparks] FunparksPatch: Firebase dup ignored: %@", __e.reason); }/g' "$PLUGIN"
        echo "[Funparks] FunparksPatch: PATCHED!"
      else
        echo "[Funparks] FunparksPatch: skipped (PLUGIN=$PLUGIN)"
      fi
    PATCHSCRIPT

    new_phase = installer.pods_project.new(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
    new_phase.name = 'FunparksFirebasePatch'
    new_phase.shell_path = '/bin/sh'
    new_phase.shell_script = patch_script.strip
    new_phase.run_only_for_deployment_postprocessing = '0'

    sources_idx = firebase_target.build_phases.index { |p| p.isa == 'PBXSourcesBuildPhase' }
    firebase_target.build_phases.insert(sources_idx || 0, new_phase)
    installer.pods_project.save
    puts "[Funparks] Added pre-compile patch to firebase_core pod target"
  else
    puts "[Funparks] WARNING: firebase_core target not found"
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end