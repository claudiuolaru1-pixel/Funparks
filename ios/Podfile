platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # Patch 1: FLTFirebaseCorePlugin.m - wrap configureWithName in @try-@catch
  core_plugin = Dir.glob("#{ENV['HOME']}/.pub-cache/**/FLTFirebaseCorePlugin.m").first
  if core_plugin
    content = File.read(core_plugin)
    unless content.include?('@try { [FIRApp configureWithName:')
      content.gsub!(/(\[FIRApp configureWithName:[^\]]+\];)/) do |m|
        "@try { #{m} } @catch (NSException *__e) { NSLog(@\"FunparksPatch\"); }"
      end
      File.write(core_plugin, content)
      puts "[Funparks] Core plugin patched!"
    else
      puts "[Funparks] Core plugin already patched"
    end
  end

  # Patch 2: FLTFirebaseAuthPlugin.m - insert early return to skip Auth.auth(app:) crash
  auth_plugin = Dir.glob("#{ENV['HOME']}/.pub-cache/**/FLTFirebaseAuthPlugin.m").first
  if auth_plugin
    content = File.read(auth_plugin)
    if content.include?('FunparksAuthPatch')
      puts "[Funparks] Auth plugin already patched"
    else
      # Insert early return right after opening brace of pluginConstantsForFIRApp:
      modified = content.sub(/pluginConstantsForFIRApp:[^{]+\{/) do |match|
        match + "\n  return @{}; // FunparksAuthPatch: skip Auth.auth crash on iOS 26"
      end
      if modified.include?('FunparksAuthPatch')
        File.write(auth_plugin, modified)
        puts "[Funparks] Auth plugin patched!"
      else
        # Fallback: find [FIRAuth authWithApp: and return before it
        modified2 = content.gsub(/(\[FIRAuth authWithApp:[^\]]+\])/) do |m|
          "nil; if(NO){ #{m} } // FunparksAuthPatch"
        end
        File.write(auth_plugin, modified2)
        puts "[Funparks] Auth plugin patched (fallback)!"
      end
    end
  else
    puts "[Funparks] WARNING: FLTFirebaseAuthPlugin.m not found!"
  end
end