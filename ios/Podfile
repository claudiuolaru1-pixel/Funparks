platform :ios, '14.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # FLTFirebaseCorePlugin.m lives in .symlinks, NOT in Pods/
  sandbox_root = installer.sandbox.root.to_s
  project_dir  = File.dirname(sandbox_root)
  puts "[Funparks] sandbox_root: #{sandbox_root}"
  puts "[Funparks] project_dir:  #{project_dir}"

  # Search entire project dir excluding Pods/
  all_files = Dir.glob(File.join(project_dir, '**', 'FLTFirebaseCorePlugin.{m,swift}'))
                 .reject { |f| f.include?('/Pods/') }
  puts "[Funparks] Found #{all_files.length} FLTFirebaseCorePlugin files:"
  all_files.each { |f| puts "[Funparks]   #{f}" }

  all_files.each do |path|
    content = File.read(path)
    next if content.include?('FunparksPatch')
    puts "[Funparks] Patching #{path}..."
    # Print lines with configure for context
    content.each_line.with_index { |l,i| puts "[Funparks] L#{i+1}: #{l.chomp}" if l.include?('configure') || l.include?('FIRApp') }
    # Multiline regex
    patched = content.gsub(
      /(\[FIRApp configureWithName:.*?\];)/m,
      "@try { \\1 } @catch (NSException *__e) { NSLog(@\"[Funparks] FunparksPatch: Firebase dup ignored: %@\", __e.reason); }"
    )
    if patched != content
      File.write(path, patched)
      puts "[Funparks] FunparksPatch: PATCHED SUCCESSFULLY"
    else
      puts "[Funparks] FunparksPatch: regex no match, dumping file:"
      puts content
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end